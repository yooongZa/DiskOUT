        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT 핵심 기능은 권한 없이도 동작합니다. 아래는 선택적으로 켤 수 있는 기능이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
