    "This does not cancel an open Paddle checkout. Close that checkout before starting another purchase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not cancel an open Paddle checkout. Close that checkout before starting another purchase."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열려 있는 Paddle 결제는 취소되지 않습니다. 새 구매를 시작하기 전에 해당 결제창을 닫아 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている Paddle の決済はキャンセルされません。別の購入を始める前に、その決済画面を閉じてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不会取消已打开的 Paddle 结账。在开始另一笔购买前，请先关闭该结账页面。"
          }
        }
      }
    },
    "Animated icons are unlocked on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animated icons are unlocked on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 움직이는 아이콘을 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでアニメーションアイコンを使用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在这台 Mac 上解锁动态图标。"
          }
        }
      }
    },
