    "\"%@\" is excluded from auto-eject. Toggle in the menu if you want it ejected on sleep.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is excluded from auto-eject. Toggle in the menu if you want it ejected on sleep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 디스크는 자동 추출에서 제외됨. 잠자기 시 같이 추출되길 원하면 메뉴에서 토글 OFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は自動取り出しから除外されています。スリープ時に取り出したい場合はメニューで切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已从自动推出中排除。如需在睡眠时推出，请在菜单中切换。"
          }
        }
      }
    },
