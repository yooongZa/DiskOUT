        }
      }
    },
    "Auto-start DiskOUT when you log in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-start DiskOUT when you log in"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 DiskOUT 자동 시작"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に DiskOUT を自動起動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动 DiskOUT"
          }
        }
      }
    },
    "Couldn't update login item": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update login item"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경하지 못했습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目を更新できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新登录项"
          }
        }
      }
    },
    "DiskOUT Permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT Permissions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT 권한 설정"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT の権限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT 权限"
          }
        }
      }
    },
    "DiskOUT's core features work without any permissions. The ones below are optional — turn on what you want.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT's core features work without any permissions. The ones below are optional — turn on what you want."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT 핵심 기능은 권한 없이도 동작합니다. 아래는 선택적으로 켤 수 있는 기능이에요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT の主要機能は権限なしで動作します。下記はオプションです — 必要なものを有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT 的核心功能无需任何权限即可使用。以下选项可选 — 按需开启。"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Eject all drives anywhere with ⌥⌘E": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject all drives anywhere with ⌥⌘E"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 ⌥⌘E로 모든 드라이브 추출"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでも ⌥⌘E で全てのドライブを取り出し"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时随地用 ⌥⌘E 弹出所有驱动器"
          }
        }
      }
    },
    "Global hotkey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global hotkey"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 단축키"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルホットキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局热键"
          }
        }
      }
    },
    "Needs approval in System Settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs approval in System Settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 승인 필요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で承認が必要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需在系统设置中授权"
          }
        }
      }
    },
    "Open System Settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "See eject results at a glance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See eject results at a glance"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출 결과를 한눈에 확인"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り出し結果をひと目で確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看弹出结果"
          }
        }
      }
    },
    "You can reopen this anytime from the menu bar icon's menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can reopen this anytime from the menu bar icon's menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바 아이콘 메뉴에서 언제든 다시 열 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンのメニューからいつでも再表示できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时从菜单栏图标的菜单中重新打开。"
          }
        }
      }
    },
    "%@\nDisks detected but won't mount. Try Disk Utility.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks detected but won't mount. Try Disk Utility."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크는 인식되는데 mount 안 됨 — 디스크 검사 필요할 수 있음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクは検出されましたがマウントできません。ディスクユーティリティをお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n检测到磁盘但无法挂载。请尝试\"磁盘工具\"。"
          }
        }
      }
    },
    "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크가 unmount 안 된 채 — 분리 시 손상 위험. 화면 켜고 메뉴에서 수동 추출 권장."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクがマウントされたままです。切断の危険があります。画面を起こして手動で取り出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n磁盘仍处于挂载状态。存在断开风险。请唤醒屏幕并手动弹出。"
          }
        }
      }
    },
    "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크가 unmount 안 된 채 sleep — 분리 시 손상 위험. wake 후 메뉴에서 수동 추출 권장."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクがマウントされたままスリープしました。切断の危険があります。復帰後に手動で取り出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n磁盘在挂载状态下进入睡眠。存在断开风险。唤醒后请手动弹出。"
          }
        }
      }
    },
    "%lld drive(s) didn't eject at display sleep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
