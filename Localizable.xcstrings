    "%@\nLogout, restart, or shutdown is continuing. Eject manually if you stay logged in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLogout, restart, or shutdown is continuing. Eject manually if you stay logged in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n로그아웃/재시동/종료는 계속 진행 중. 취소해서 로그인 상태로 남으면 수동 추출 권장."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nログアウト、再起動、またはシャットダウンが進行中です。ログインしたままの場合は手動で取り出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n注销、重启或关机正在继续。如保持登录,请手动弹出。"
          }
        }
      }
