      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut you chose is now assigned to this action. Conflicting actions were moved to unused shortcuts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 단축키를 이 동작에 배정했습니다. 충돌한 다른 동작은 사용하지 않는 단축키로 옮겼습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したショートカットをこの操作に割り当てました。競合する他の操作は、未使用のショートカットに移動しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将所选快捷键分配给此操作。发生冲突的其他操作已移至未使用的快捷键。"
          }
        }
