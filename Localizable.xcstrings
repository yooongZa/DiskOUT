    "Writing to an external disk — don't disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing to an external disk — don't disconnect"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 디스크에 쓰는 중 — 분리하지 마세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクに書き込み中 — 取り外さないでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入外置磁盘 — 请勿断开"
          }
        }
      }
    },
    "Reading from an external disk — don't disconnect": {
      "extractionState": "manual",
      "localizations": {
