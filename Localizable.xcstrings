{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\nDisks detected but won't mount. Try Disk Utility." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\nDisks detected but won't mount. Try Disk Utility." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@\n디스크는 인식되는데 mount 안 됨 — 디스크 검사 필요할 수 있음" } }
      }
    },
    "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@\n디스크가 unmount 안 된 채 — 분리 시 손상 위험. 화면 켜고 메뉴에서 수동 추출 권장." } }
      }
    },
    "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@\n디스크가 unmount 안 된 채 sleep — 분리 시 손상 위험. wake 후 메뉴에서 수동 추출 권장." } }
      }
    },
    "%lld drive(s) didn't eject at display sleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld drive(s) didn't eject at display sleep" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "화면 꺼짐 시 %lld개 디스크 추출 실패" } }
      }
    },
    "%lld drive(s) didn't eject before sleep" : {
      "extractionState" : "manual",
