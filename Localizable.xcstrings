    "Auto-quit Music and Photos before sleep, relaunch on wake. Useful when libraries are on external drives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-quit Music and Photos before sleep, relaunch on wake. Useful when libraries are on external drives."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
