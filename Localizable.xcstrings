    "Notifications are silent by design — no sound. Look for the menu bar icon for results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are silent by design — no sound. Look for the menu bar icon for results."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 의도적으로 무음 — 결과는 메뉴바 아이콘으로 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
