    "Recovery Code Copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery Code Copied"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 코드가 복사되었습니다"
          }
        },
        "ja": {
          "stringUnit": {
