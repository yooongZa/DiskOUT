    "Eject and Mount can't share the same shortcut. %@ was moved to a different preset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject and Mount can't share the same shortcut. %@ was moved to a different preset."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출과 마운트는 같은 단축키를 사용할 수 없습니다. %@ 단축키를 다른 프리셋으로 이동했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「取り出し」と「マウント」は同じショートカットを共有できません。%@ を別のプリセットに移動しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“推出”和“挂载”不能共用同一快捷键。%@ 已移至其他预设。"
          }
        }
      }
    },
    "Eject and Sleep can't share its shortcut with Eject all or Mount all. Pick a different one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject and Sleep can't share its shortcut with Eject all or Mount all. Pick a different one."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'추출하고 잠자기'는 '모두 추출' 또는 '모두 마운트'와 같은 단축키를 사용할 수 없습니다. 다른 프리셋을 선택하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「取り出してスリープ」は「全て取り出し」や「全てマウント」とショートカットを共有できません。別のものを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“推出并睡眠”不能与“推出全部”或“挂载全部”共用快捷键。请选择其他快捷键。"
          }
        }
      }
    },
