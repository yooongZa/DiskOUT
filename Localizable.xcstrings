          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 우클릭(또는 Control-클릭)이 추출 대신 메뉴를 엽니다. 실수로 외장 드라이브를 추출하는 것을 방지합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
