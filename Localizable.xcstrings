    "Eject and Mount can't share the same shortcut. %@ was moved to a different preset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject and Mount can't share the same shortcut. %@ was moved to a different preset."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출과 마운트는 같은 단축키를 쓸 수 없음. %@ 단축키를 다른 preset 으로 이동함."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「取り出し」と「マウント」は同じショートカットを共有できません。%@ を別のプリセットに移動しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"弹出\"和\"挂载\"不能共用同一快捷键。%@ 已移至其他预设。"
          }
        }
      }
    },
    "Eject and Sleep can't share its shortcut with Eject all or Mount all. Pick a different one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject and Sleep can't share its shortcut with Eject all or Mount all. Pick a different one."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'추출하고 잠자기' 는 모두 추출/모두 마운트와 같은 단축키를 쓸 수 없음. 다른 preset 선택."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「取り出してスリープ」は「全て取り出し」や「全てマウント」とショートカットを共有できません。別のものを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"弹出并睡眠\"不能与\"弹出全部\"或\"挂载全部\"共用快捷键。请选择其他快捷键。"
          }
        }
      }
    },
