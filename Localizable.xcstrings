          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了して再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出应用并重试"
          }
        }
      }
    },
    "Still couldn't eject %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
