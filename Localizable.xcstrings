        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 의도적으로 무음 — 결과는 메뉴바 아이콘으로 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
