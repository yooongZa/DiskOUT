{
  "sourceLanguage": "en",
  "strings": {
    "Send anonymous crash & error reports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send anonymous crash & error reports"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 충돌 및 오류 보고서 보내기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名のクラッシュ・エラーレポートを送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送匿名崩溃和错误报告"
          }
        }
      }
    },
    "Sends only crash type, anonymized stack traces, and error categories. Never disk names, file paths, or your identity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends only crash type, anonymized stack traces, and error categories. Never disk names, file paths, or your identity."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌 유형, 익명화된 스택 추적, 오류 분류만 보냅니다. 디스크 이름, 파일 경로, 사용자 정보는 절대 보내지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュの種類、匿名化されたスタックトレース、エラー分類のみを送信します。ディスク名、ファイルパス、個人情報は一切送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送崩溃类型、匿名化的堆栈跟踪和错误类别。绝不发送磁盘名称、文件路径或您的身份信息。"
          }
        }
      }
    },
    "\"%@\" is being written to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is being written to"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에 쓰는 중입니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" に書き込み中です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入 \"%@\""
          }
        }
      }
    },
    "An external disk is being written to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An external disk is being written to"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 디스크에 쓰는 중입니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクに書き込み中です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入外置磁盘"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Eject Anyway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject Anyway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 추출"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然推出"
          }
        }
      }
    },
    "Ejecting now will interrupt the copy and may corrupt files. Eject anyway?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting now will interrupt the copy and may corrupt files. Eject anyway?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 추출하면 복사가 중단되고 파일이 손상될 수 있습니다. 그래도 추출할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今取り出すとコピーが中断され、ファイルが破損する可能性があります。取り出しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在推出会中断复制并可能损坏文件。仍要推出吗?"
          }
        }
      }
    },
    "%@ is using this disk. Quit it and try ejecting again?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using this disk. Quit it and try ejecting again?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 디스크를 사용 중입니다. 종료하고 다시 추출할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこのディスクを使用中です。終了して再度取り出しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用此磁盘。退出并重新推出?"
          }
        }
      }
    },
    "Quit apps and retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit apps and retry"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 종료 후 재시도"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了して再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出应用并重试"
          }
        }
      }
    },
    "Still couldn't eject %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still couldn't eject %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 여전히 추출할 수 없습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をまだ取り出せませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍无法推出 %@"
          }
        }
      }
    },
    "Writing to an external disk — don't disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing to an external disk — don't disconnect"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 디스크에 쓰는 중 — 분리하지 마세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクに書き込み中 — 取り外さないでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入外置磁盘 — 请勿断开"
          }
        }
      }
    },
    "Reading from an external disk — don't disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading from an external disk — don't disconnect"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 디스크에서 읽는 중 — 분리하지 마세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクから読み込み中 — 取り外さないでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取外置磁盘 — 请勿断开"
          }
        }
      }
    },
    "Reading and writing an external disk — don't disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading and writing an external disk — don't disconnect"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 디스크를 읽고 쓰는 중 — 분리하지 마세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けディスクを読み書き中 — 取り外さないでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读写外置磁盘 — 请勿断开"
          }
        }
      }
    },
    "Allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ko": {
