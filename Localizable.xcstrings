    "Tip: right-clicking the menu bar icon also ejects all drives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: right-clicking the menu bar icon also ejects all drives."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 메뉴바 아이콘을 우클릭해도 모두 추출됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント: メニューバーアイコンを右クリックしても全て取り出せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：右键点击菜单栏图标也可推出全部。"
          }
        }
      }
    },
    "Eject all external drives right before the Mac sleeps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject all external drives right before the Mac sleeps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 이 잠자기에 들어가기 직전에 모든 외장 드라이브를 추출합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac がスリープする直前にすべての外部ドライブを取り出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 进入睡眠前推出所有外置驱动器。"
          }
        }
      }
    },
    "Also eject when only the display goes to sleep — for Macs set to never sleep.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also eject when only the display goes to sleep — for Macs set to never sleep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면만 꺼질 때도 추출합니다 — 본체가 잠자지 않게 설정된 Mac 용."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイのみがスリープするときにも取り出します — 本体をスリープさせない設定の Mac 向け。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示器睡眠时也推出——适用于设置为从不睡眠的 Mac。"
          }
        }
      }
    },
    "Retry with a force unmount when a normal eject fails.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry with a force unmount when a normal eject fails."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 추출이 실패하면 강제 마운트 해제로 재시도합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の取り出しに失敗した場合、強制アンマウントで再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通推出失败时，使用强制卸载重试。"
          }
        }
      }
    },
