    "%@\nDisks detected but won't mount. Try Disk Utility.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks detected but won't mount. Try Disk Utility."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크가 인식되었지만 마운트되지 않습니다. 디스크 유틸리티에서 확인해 보십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクは検出されましたがマウントできません。ディスクユーティリティをお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n检测到磁盘但无法挂载。请尝试“磁盘工具”。"
          }
        }
      }
    },
    "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks still mounted. Disconnect risk. Wake screen and eject manually."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크가 마운트된 상태입니다. 분리하면 손상될 수 있습니다. 화면을 깨운 뒤 메뉴에서 직접 추출하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクがマウントされたままです。切断の危険があります。画面を起こして手動で取り出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n磁盘仍处于挂载状态。存在断开风险。请唤醒屏幕并手动推出。"
          }
        }
      }
    },
    "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDisks went to sleep still mounted. Disconnect risk. Eject manually after wake."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n디스크가 마운트된 채 잠자기에 들었습니다. 분리하면 손상될 수 있습니다. Mac을 깨운 뒤 메뉴에서 직접 추출하십시오."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nディスクがマウントされたままスリープしました。切断の危険があります。復帰後に手動で取り出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n磁盘在挂载状态下进入睡眠。存在断开风险。唤醒后请手动推出。"
          }
        }
      }
    },
