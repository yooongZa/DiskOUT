    "Eject Anyway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject Anyway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 추출"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも取り出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然推出"
          }
        }
      }
    },
    "Ejecting now will interrupt the copy and may corrupt files. Eject anyway?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting now will interrupt the copy and may corrupt files. Eject anyway?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 추출하면 복사가 중단되고 파일이 손상될 수 있습니다. 그래도 추출할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今取り出すとコピーが中断され、ファイルが破損する可能性があります。取り出しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在推出会中断复制并可能损坏文件。仍要推出吗？"
          }
        }
      }
    },
    "%@ is using this disk. Quit it and try ejecting again?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using this disk. Quit it and try ejecting again?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 디스크를 사용 중입니다. 종료하고 다시 추출할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこのディスクを使用中です。終了して再度取り出しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用此磁盘。退出并重新推出？"
          }
        }
      }
    },
    "Quit apps and retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit apps and retry"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
