    "DiskOUT couldn’t update the login item. Check System Settings → General → Login Items, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT couldn’t update the login item. Check System Settings → General → Login Items, then try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT이 로그인 항목을 변경하지 못했습니다. 시스템 설정 → 일반 → 로그인 항목을 확인한 후 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskOUT はログイン項目を更新できませんでした。システム設定 → 一般 → ログイン項目を確認して、もう一度お試しください。"
          }
